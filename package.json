{
  "name": "launchpad-chrome-extension",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "test:ui": "playwright test",
    "check": "node scripts/check.cjs && node scripts/check-docs.cjs && node scripts/check-secrets.cjs",
    "build": "node scripts/build.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "verify": "npm run check && npm test && npm run build && npm run verify:package && npm run test:package",
    "test:package": "node scripts/smoke-package.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "fflate": "^0.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
