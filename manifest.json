{
  "manifest_version": 3,
  "name": "LaunchPad",
  "version": "1.1.0",
  "key": "",
  "description": "A Google-style research new tab with shortcuts, arXiv filters, a configurable Scour feed and academic GitHub discovery.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/app/icon16.png",
      "32": "icons/app/icon32.png",
      "48": "icons/app/icon48.png",
      "128": "icons/app/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "favicon"
  ],
  "host_permissions": [
    "https://rss.arxiv.org/*",
    "https://scour.ing/*",
    "https://www.scour.ing/*",
    "https://api.ossinsight.io/*",
    "https://api.github.com/*"
  ],
  "optional_permissions": [
    "identity"
  ],
  "oauth2": {
    "client_id": "1006471653686-sgr6sgp6lqcg4q4gtrqmul8bvu310g47.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icons/app/icon16.png",
    "32": "icons/app/icon32.png",
    "48": "icons/app/icon48.png",
    "128": "icons/app/icon128.png"
  },
  "minimum_chrome_version": "114",
  "homepage_url": "https://github.com/dtjgp/LaunchPad"
}
